# Copy this file to .env and fill in your key. Never commit .env.
# The assistant: Gemini 3.1 Flash-Lite through OpenRouter
OPENROUTER_API_KEY=
GATEWELL_MODEL=google/gemini-3.1-flash-lite

# Demo version: 5 assistant questions per visitor (set GATEWELL_DEMO_MODE=0 to turn off)
GATEWELL_DEMO_MODE=1
GATEWELL_DEMO_CHAT_LIMIT=5

# On Railway, point these at the mounted volume (the sample database is copied there on first start):
# GATEWELL_DB=/data/car_parts_inventory.db
# GATEWELL_LOG_DIR=/data/logs
# With live data instead of the October 2026 snapshot:
# GATEWELL_AS_OF=now
